# Dependencies
node_modules/

# Build output
dist/
target/

# Runtime artifacts (NeoXten existing)
.neoxten-out/
.neoxten/
.neoxten-operator-e2e/
sample-pack.zip

# Factory runtime (local per machine)
ops/factory/runs/
ops/factory/consequence-memory.ndjson
ops/bugs/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor state
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo

# Temporary test configs
*.tmp.yaml
*.tmp.json
*.bak
.local/

# Environment / secrets (should never exist here)
.env
.env.*
!.env.example
!.env.plastypesa.example
credentials.json
*.pem
*.key
*.keystore

# Tauri build output
src-tauri/target/
src-tauri/gen/

# Staged desktop bundle (generated by scripts/prepare-windows-bundle.mjs); keep .gitkeep for Tauri resource paths
src-tauri/resources/neoxten-runtime/**
!src-tauri/resources/neoxten-runtime/.gitkeep
src-tauri/resources/nodejs/**
!src-tauri/resources/nodejs/.gitkeep
src-tauri/resources/.cache/

# UI build output
ui/dist/
ui/node_modules/

# TypeScript incremental build info (machine-local)
*.tsbuildinfo

# Playwright / local validation artifacts
test-results/
playwright-report/
.neoxten-bundle-validate/

# Ad-hoc screenshots / proof files (do not commit)
.validation-ui-proof.png
.velarune-studio-e2e-data/
response.txt
screen.png
screen*.xml
