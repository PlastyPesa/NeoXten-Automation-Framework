# Factory .env — Machine-specific configuration (NEVER committed to Git)
# Copy this to .env and fill in your values.

# --- Local Inference (llama.cpp) ---
# Path to llama-server binary (required for local model inference)
LLAMA_SERVER_PATH=C:\Users\Bobby\Documents\neoxtemus-ai\bin\llama-cpp\llama-server.exe

# Directory containing .gguf model files
MODEL_DIR=C:\Users\Bobby\Documents\neoxtemus-ai\models

# --- Remote API Fallback ---
# Used when local inference fails or model is absent
LLM_API_KEY=
LLM_API_PROVIDER=anthropic
LLM_API_MODEL=claude-sonnet-4-20250514

# --- Android Signing (only for Android store packs) ---
# ANDROID_KEYSTORE_PATH=C:\path\to\release.keystore
# ANDROID_KEY_ALIAS=release
# ANDROID_STORE_PASSWORD=
# ANDROID_KEY_PASSWORD=

# --- GitHub (for release publishing) ---
# GITHUB_TOKEN is managed by gh CLI auth, not needed here unless scripting

# --- PlastyPesa API regression (scripts/plastypesa/README.md) ---
# PLASTYPESA_API_BASE=https://....amazonaws.com/prod/api
# Auth (pick one): injected JWT OR email/password login (token cached under .neoxten/ unless disabled)
# PLASTYPESA_USER_JWT=
# PLASTYPESA_TEST_EMAIL=
# PLASTYPESA_TEST_PASSWORD=
# PLASTYPESA_TEST_DEVICE_ID=   # optional login body
# PLASTYPESA_TOKEN_CACHE=0     # set to 0 to disable file cache (always fresh login)
# PLASTYPESA_TOKEN_CACHE_PATH= # optional override for cache file path
# PLASTYPESA_REQUIRE_AUTHENTICATED=1  # fail run if no JWT (CI release gate)
# PLASTYPESA_RELEASE_PACK=1           # use release-pack-config.mjs suite list when PLASTYPESA_SUITES unset
# PLASTYPESA_AUTH_ONLY=1       # only protection checks
# PLASTYPESA_SUITES=auth-baseline,sort-proof
# PLASTYPESA_SORT_PROOF_E2E=1  # optional: live Anthropic call (staging only)

# --- PlastyPesa orchestrated E2E (npm run test:plastypesa-e2e) — see scripts/plastypesa/PLASTYPESA_E2E.md ---
# PLASTYPESA_ADMIN_EMAIL=
# PLASTYPESA_ADMIN_PASSWORD=
# PLASTYPESA_ADMIN_BASE_URL=http://127.0.0.1:8080
# PLASTYPESA_ADMIN_WEBSERVER=0   # set if Vite already running
# PLASTYPESA_E2E_SKIP_API=1
# PLASTYPESA_E2E_API_MODE=smoke   # or release-pack
# PLASTYPESA_E2E_SKIP_MOBILE=1
# PLASTYPESA_ANDROID_DEVICE=0123456789ABCDEF

# --- Sort-proof visibility E2E (npm run test:plastypesa-e2e:sort-proof-visibility) ---
# JWT must match the user logged in on the device. See scripts/plastypesa/PLASTYPESA_SORT_PROOF_VISIBILITY_E2E.md
# PLASTYPESA_SORT_PROOF_E2E_SKIP_RESTORE=1
