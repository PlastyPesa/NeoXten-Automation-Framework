# Copy to `.env.plastypesa` (gitignored) — loaded after `.env` for PLASTYPESA_* keys only.
# Required for sort-proof visibility E2E and API regression.

# PLASTYPESA_API_BASE=https://....amazonaws.com/prod/api
# PLASTYPESA_USER_JWT=
# or:
# PLASTYPESA_TEST_EMAIL=
# PLASTYPESA_TEST_PASSWORD=

# Admin Playwright (sort-proof E2E)
# PLASTYPESA_ADMIN_EMAIL=
# PLASTYPESA_ADMIN_PASSWORD=
