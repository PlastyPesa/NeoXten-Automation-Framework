# Copy to `.env.plastypesa` (gitignored) — loaded after `.env` for PLASTYPESA_* keys only.
# Required for sort-proof visibility E2E and API regression.

# PLASTYPESA_API_BASE=https://....amazonaws.com/prod/api
# PLASTYPESA_USER_JWT=
# or:
# PLASTYPESA_TEST_EMAIL=
# PLASTYPESA_TEST_PASSWORD=

# Admin Playwright (sort-proof E2E)
# PLASTYPESA_ADMIN_EMAIL=
# PLASTYPESA_ADMIN_PASSWORD=

# Optional: point NeoXten at a local credential registry instead of hardcoding credentials in env.
# If omitted, NeoXten uses .local/plastypesa-credential-registry.json and the existing
# PlastyPesa machine-local credentials folder by default.
# PLASTYPESA_CREDENTIAL_REGISTRY=
# PLASTYPESA_CREDENTIALS_DIR=
